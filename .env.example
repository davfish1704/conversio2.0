# Cloudflare R2 (Asset-Speicher)
# Anleitung:
# 1. Cloudflare Dashboard → R2 → Bucket erstellen (z.B. "conversio-assets")
# 2. Bucket → Settings → Public Access aktivieren → Public URL kopieren
# 3. R2 → Manage R2 API Tokens → Token mit Object Read & Write erstellen
R2_ACCOUNT_ID="7da1c77d47a2d28ff10b5eba2196bbce"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="conversio-assets"
R2_PUBLIC_URL="https://pub-66f6a5857d144d75aaf2aa3a87dbe8cc.r2.dev"

# Supervisor Admin Bot (Telegram — separater Bot, NICHT der Customer-Bot!)
# Bot erstellen: @BotFather → /newbot → Token kopieren
# Webhook Secret: beliebiger langer zufälliger String
