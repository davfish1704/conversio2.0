generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// AUTH
// ============================================

model User {
  id                String       @id @default(cuid())
  email             String       @unique
  name              String?
  googleId          String?      @unique @map("google_id")
  image             String?
  password          String?
  emailVerified     DateTime?    @map("email_verified")
  verifyToken       String?      @unique @map("verify_token")
  verifyTokenExpiry DateTime?    @map("verify_token_expiry")
  role              UserRole     @default(USER)
  timezone          String?      @default("Europe/Berlin")
  language          String?      @default("de")
  adminChannel        AdminChannel @default(TELEGRAM)
  adminTelegramChatId String?
  adminWhatsappNumber String?
  isSuperAdmin        Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  accounts         Account[]
  sessions         Session[]
  memberships      TeamMember[]
  ownedTeams       Team[]             @relation("TeamOwner")
  boardMembers     BoardMember[]
  messages         Message[]          @relation("MessageAuthor")
  assignedLeads    Lead[]             @relation("LeadAssignee")
  approvedActions  SupervisorAction[] @relation("ActionApprover")

  @@map("users")
}

enum AdminChannel {
  TELEGRAM
  WHATSAPP
  EMAIL
}

enum UserRole {
  ADMIN
  USER
  AGENT
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

// ============================================
// TEAMS
// ============================================

model Team {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String
  plan      String   @default("free")
  createdAt DateTime @default(now())

  owner   User         @relation("TeamOwner", fields: [ownerId], references: [id])
  members TeamMember[]
  boards  Board[]

  @@map("teams")
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     Role     @default(MEMBER)
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

enum Role {
  ADMIN
  MEMBER
  VIEWER
}

// ============================================
// BOARDS & PIPELINE
// ============================================

model Board {
  id                String           @id @default(cuid())
  teamId            String
  name              String
  description       String?
  isActive          Boolean          @default(true)
  ownerId           String
  adminStatus       BoardAdminStatus @default(ACTIVE)
  ownerStatus       BoardOwnerStatus @default(ACTIVE)
  behaviorMode      String           @default("reactive")
  boardCustomFields Json             @default("[]")
  contextWindowSize Int              @default(20)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  team             Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  states           State[]           @relation("BoardStates")
  members          BoardMember[]
  leads            Lead[]
  conversations    Conversation[]
  reports          AdminReport[]
  brain            BoardBrain?
  assets           BoardAsset[]
  mediaAssets      Asset[]
  executionLogs    ExecutionLog[]
  brainDocuments   BrainDocument[]
  brainRules       BrainRule[]
  brainFAQs        BrainFAQ[]
  channels         BoardChannel[]
  channelInvites   ChannelInvite[]
  aiProviderConfig AIProviderConfig?
  usageLogs         UsageLog[]
  agentRuns         AgentRun[]
  supervisorActions SupervisorAction[]

  @@map("boards")
}

enum BoardAdminStatus {
  ACTIVE
  PAUSED
  SUSPENDED
}

enum BoardOwnerStatus {
  ACTIVE
  INACTIVE
  TRIAL
}

model BoardMember {
  id       String    @id @default(cuid())
  boardId  String
  userId   String
  role     BoardRole @default(AGENT)
  joinedAt DateTime  @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@map("board_members")
}

enum BoardRole {
  ADMIN
  AGENT
  VIEWER
}

model State {
  id                      String      @id @default(cuid())
  boardId                 String
  name                    String
  type                    StateType   @default(MESSAGE)
  // CONDITION routing only — parsed by state-machine.ts. NOT for AI prompts.
  rules                   String?
  orderIndex              Int         @default(0)
  isActive                Boolean     @default(true)
  autoTransition          Boolean     @default(false)
  nextStateId             String?
  config                  Json?
  fieldDefinitions        Json?
  behaviorMode            String?
  dataToCollect           Json        @default("[]")
  completionRule          String?
  availableTools          Json        @default("[]")
  escalateOnNoReply       Int?
  escalateOnLowConfidence Boolean     @default(true)
  escalateOnOffMission    Boolean     @default(true)
  maxFollowups            Int         @default(3)
  followupAction          String      @default("escalate")
  followupTargetState     String?
  allowChannelSwitch      Boolean     @default(true)

  // === Sub-Agent Configuration ===
  agentRole           String?
  agentSystemPrompt   String?     @db.Text
  agentGoal           String?     @db.Text

  // === Handoff Engine ===
  handoffMode         HandoffMode          @default(HYBRID)
  handoffRules        Json                 @default("[]")
  minAgentConfidence  Float                @default(0.7)
  nextStateOnFail     String?
  autoApproveActions  SupervisorActionType[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board         Board          @relation("BoardStates", fields: [boardId], references: [id], onDelete: Cascade)
  leads         Lead[]         @relation("LeadCurrentState")
  conversations Conversation[] @relation("ConversationCurrentState")
  assetLinks    AssetState[]
  agentRuns     AgentRun[]

  @@map("states")
}

enum StateType {
  AI
  MESSAGE
  TEMPLATE
  CONDITION
  WAIT
}

enum HandoffMode {
  LLM_ONLY
  RULE_ONLY
  HYBRID
}

// ============================================
// LEADS (CRM-Kontakt)
// ============================================

model Lead {
  id             String    @id @default(cuid())
  boardId        String
  currentStateId String?
  assignedToId   String?
  name           String?
  phone          String?
  email          String?
  avatar         String?
  source         String?   @default("manual")
  channel        String?   @default("whatsapp")
  tags           String[]  @default([])
  leadScore      Int       @default(0)
  stateHistory   Json?
  stageMovedAt   DateTime?
  stageMovedBy   String?
  customData     Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  board             Board              @relation(fields: [boardId], references: [id], onDelete: Cascade)
  currentState      State?             @relation("LeadCurrentState", fields: [currentStateId], references: [id])
  assignedTo        User?              @relation("LeadAssignee", fields: [assignedToId], references: [id])
  conversations     Conversation[]
  memories          LeadMemory[]
  channelInvites    ChannelInvite[]
  agentRuns         AgentRun[]
  supervisorActions SupervisorAction[]

  @@index([boardId, currentStateId])
  @@map("leads")
}

// ============================================
// CONVERSATIONS & NACHRICHTEN
// ============================================

model Conversation {
  id                   String             @id @default(cuid())
  leadId               String
  boardId              String
  currentStateId       String?
  channel              String             @default("whatsapp")
  externalId           String?
  status               ConversationStatus @default(ACTIVE)
  frozen               Boolean            @default(false)
  frozenAt             DateTime?
  frozenReason         String?
  frozenBy             String?
  aiEnabled            Boolean            @default(true)
  followupCount        Int                @default(0)
  conversationSummary  String?
  summaryUpdatedAt     DateTime?
  messageCountSinceSum Int                @default(0)
  customData           Json               @default("{}")
  lastMessageAt        DateTime           @default(now())
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  lead              Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  board             Board              @relation(fields: [boardId], references: [id], onDelete: Cascade)
  currentState      State?             @relation("ConversationCurrentState", fields: [currentStateId], references: [id])
  messages          Message[]
  executionLogs     ExecutionLog[]
  usageLogs         UsageLog[]
  agentRuns         AgentRun[]
  supervisorActions SupervisorAction[]

  @@index([leadId, lastMessageAt])
  @@index([boardId, status, lastMessageAt])
  @@map("conversations")
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  SPAM
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  authorId       String?
  direction      Direction
  content        String
  mediaUrl       String?
  messageType    MessageType   @default(TEXT)
  status         MessageStatus @default(SENT)
  aiGenerated    Boolean       @default(false)
  externalId     String?
  timestamp      DateTime      @default(now())
  metadata       Json?

  author       User?        @relation("MessageAuthor", fields: [authorId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, timestamp])
  @@map("messages")
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  TEMPLATE
  LOCATION
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

// ============================================
// AGENT RUNS (Sub-Agent Audit Log)
// ============================================

model AgentRun {
  id             String @id @default(cuid())

  // Context
  conversationId String
  leadId         String
  stateId        String
  boardId        String

  // Prompt & Input
  systemPromptUsed String @db.Text
  userMessageInput String @db.Text
  contextMessages  Json   @default("[]")

  // LLM Details
  model        String
  provider     String
  inputTokens  Int    @default(0)
  outputTokens Int    @default(0)
  totalTokens  Int    @default(0)
  costCents    Float  @default(0)
  latencyMs    Int    @default(0)

  // Output
  agentResponse String? @db.Text
  toolCallsMade Json    @default("[]")

  // Handoff Decision
  handoffProposed Boolean  @default(false)
  handoffReason   String?  @db.Text
  agentConfidence Float?
  rulesPassed     Boolean?
  ruleEvaluation  Json?
  targetStateId   String?

  // Outcome
  outcome      AgentRunOutcome
  errorMessage String?         @db.Text

  createdAt DateTime @default(now())

  conversation  Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  lead          Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  state         State          @relation(fields: [stateId], references: [id])
  board         Board          @relation(fields: [boardId], references: [id], onDelete: Cascade)
  executionLogs ExecutionLog[]

  @@index([conversationId, createdAt])
  @@index([boardId, createdAt])
  @@index([leadId, createdAt])
  @@map("agent_runs")
}

enum AgentRunOutcome {
  SUCCESS_CONTINUE
  SUCCESS_HANDOFF
  HANDOFF_BLOCKED
  TOOL_EXECUTION_FAILED
  LLM_ERROR
  ESCALATED
}

// ============================================
// LEAD-GEDÄCHTNIS
// ============================================

model LeadMemory {
  id        String   @id @default(cuid())
  leadId    String
  key       String
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, key])
  @@index([leadId])
  @@map("lead_memory")
}

// ============================================
// KANÄLE
// ============================================

model BoardChannel {
  id                    String    @id @default(cuid())
  boardId               String
  platform              String
  status                String    @default("disconnected")
  telegramBotToken      String?
  telegramBotUsername   String?
  telegramWebhookSecret String?
  waPhoneNumber         String?
  waPhoneNumberId       String?
  waAccessToken         String?
  waBusinessAccountId   String?
  waVerifyToken         String?
  webhookSecret         String?
  igPageId              String?
  igAccessToken         String?
  lastError             String?
  connectedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  board          Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  channelInvites ChannelInvite[]

  @@unique([boardId, platform])
  @@map("board_channels")
}

model ChannelInvite {
  id                     String              @id @default(cuid())
  boardId                String
  leadId                 String?
  source                 InviteSource        @default(LEAD_REINVITE)
  campaign               String?
  targetChannelId        String
  token                  String              @unique
  status                 ChannelInviteStatus @default(PENDING)
  createdBy              String?
  reason                 String?
  expiresAt              DateTime
  consumedAt             DateTime?
  consumedConversationId String?
  createdAt              DateTime            @default(now())

  board   Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  lead    Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel BoardChannel @relation(fields: [targetChannelId], references: [id])

  @@index([token])
  @@index([leadId, createdAt])
  @@map("channel_invites")
}

enum ChannelInviteStatus {
  PENDING
  CONSUMED
  EXPIRED
}

enum InviteSource {
  LEAD_REINVITE
  BOARD_ACQUISITION
}

// ============================================
// BRAINLAB
// ============================================

model BoardBrain {
  id                    String   @id @default(cuid())
  boardId               String   @unique
  systemPrompt          String   @db.Text
  stylePrompt           String   @db.Text
  infoPrompt            String   @db.Text
  rulePrompt            String   @db.Text
  defaultModel          String   @default("gpt-4o-mini")
  temperature           Float    @default(0.7)
  maxTokens             Int      @default(500)
  language              String   @default("de")
  tone                  String   @default("friendly")
  channelSwitchTemplate String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@map("board_brains")
}

model BoardAsset {
  id        String         @id @default(cuid())
  boardId   String
  type      BrainAssetType
  name      String
  content   String?        @db.Text
  fileUrl   String?
  metadata  Json?
  isActive  Boolean        @default(true)
  tags      String[]
  createdAt DateTime       @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId, type])
  @@map("board_assets")
}

enum BrainAssetType {
  AUDIO_MEMO
  PDF_DOC
  IMAGE_ASSET
  TEXT_SNIPPET
  TEMPLATE
  KNOWLEDGE_BASE
}

// ============================================
// MEDIA ASSETS (R2-backed file storage)
// ============================================

model Asset {
  id          String       @id @default(cuid())
  boardId     String
  name        String
  description String?
  type        AssetType
  mimeType    String
  sizeBytes   Int
  r2Key         String       @unique
  publicUrl     String
  extractedText String?      @db.Text
  embedding     Unsupported("vector(1536)")?
  tags          String[]     @default([])
  uploadedBy  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  board Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  links AssetState[]

  @@index([boardId])
  @@index([boardId, type])
  @@index([tags], type: Gin)
  @@map("assets")
}

model AssetState {
  id        String   @id @default(cuid())
  assetId   String
  stateId   String
  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  state State @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@unique([assetId, stateId])
  @@index([stateId])
  @@map("asset_states")
}

enum AssetType {
  IMAGE
  PDF
  AUDIO
  VIDEO
  DOCUMENT
}

model BrainDocument {
  id        String   @id @default(cuid())
  boardId   String
  name      String
  content   String   @db.Text
  category  String   @default("general")
  embedding Unsupported("vector(1536)")?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId, category])
  @@map("brain_documents")
}

model BrainRule {
  id        String   @id @default(cuid())
  boardId   String
  name      String
  rule      String   @db.Text
  severity  String   @default("warning")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@map("brain_rules")
}

model BrainFAQ {
  id        String   @id @default(cuid())
  boardId   String
  question  String
  answer    String   @db.Text
  category  String?
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId, category])
  @@map("brain_faqs")
}

// ============================================
// MELDUNGEN & ALERTS
// ============================================

model AdminReport {
  id         String      @id @default(cuid())
  boardId    String
  stateId    String?
  type       AlertType
  message    String
  details    String?
  status     AlertStatus @default(OPEN)
  createdAt  DateTime    @default(now())
  resolvedAt DateTime?

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@map("admin_reports")
}

enum AlertType {
  STUCK
  ERROR
  MANUAL_INTERVENTION
  LOOP
  INFO
}

enum AlertStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  IGNORED
}

// ============================================
// AUSFÜHRUNGSPROTOKOLLE
// ============================================

model ExecutionLog {
  id             String          @id @default(cuid())
  agentRunId     String?
  boardId        String
  conversationId String
  stateId        String?
  action         String
  input          String?         @db.Text
  output         String?         @db.Text
  context        Json?
  status         ExecutionStatus @default(SUCCESS)
  errorMessage   String?
  stuckDuration  Int?
  needsAttention Boolean         @default(false)
  createdAt      DateTime        @default(now())

  board        Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id])
  agentRun     AgentRun?    @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([boardId, status, createdAt])
  @@index([agentRunId])
  @@map("execution_logs")
}

enum ExecutionStatus {
  SUCCESS
  ERROR
  STUCK
  WAITING_USER
  MANUAL_INTERVENTION
  LOOP
}

// ============================================
// AI-PROVIDER & PLATFORM-SCHLÜSSEL
// ============================================

model AIProviderConfig {
  id               String   @id @default(cuid())
  boardId          String   @unique
  defaultProvider  String   @default("groq")
  defaultModel     String   @default("llama-3.3-70b-versatile")
  fallbackProvider String?
  fallbackModel    String?
  modelOverrides   Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@map("ai_provider_configs")
}

model PlatformAPIKey {
  id                 String   @id @default(cuid())
  provider           String   @unique
  encryptedKey       String
  isActive           Boolean  @default(true)
  monthlyBudgetCents Int?
  createdAt          DateTime @default(now())

  @@map("platform_api_keys")
}

// ============================================
// HINTERGRUND-JOBS
// ============================================

model Job {
  id           String    @id @default(cuid())
  type         String
  payload      Json
  scheduledFor DateTime
  status       JobStatus @default(PENDING)
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  lastError    String?
  leadId       String?
  boardId      String?
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  @@index([status, scheduledFor])
  @@index([leadId])
  @@map("jobs")
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  DEAD
}

model FailedJob {
  id        String   @id @default(cuid())
  jobId     String   @unique
  type      String
  payload   Json
  lastError String?
  attempts  Int
  boardId   String?
  leadId    String?
  createdAt DateTime @default(now())

  @@map("failed_jobs")
}

// ============================================
// TOKEN USAGE TRACKING
// ============================================

model UsageLog {
  id             String   @id @default(cuid())
  boardId        String
  conversationId String?
  model          String
  provider       String   @default("unknown")
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  totalTokens    Int      @default(0)
  providerCost   Float    @default(0)
  creditCharged  Float    @default(0)
  createdAt      DateTime @default(now())

  board        Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([boardId, createdAt])
  @@index([model, createdAt])
  @@map("usage_logs")
}

// ============================================
// ADMIN NOTIFICATIONS (system-level alerts)
// ============================================

model AdminNotification {
  id                 String            @id @default(cuid())
  boardId            String?
  leadId             String?
  level              NotificationLevel @default(INFO)
  title              String
  message            String            @db.Text
  metadata           Json              @default("{}")
  telegramSent       Boolean           @default(false)
  telegramMessageId  String?
  acknowledgedAt     DateTime?
  acknowledgedBy     String?
  channel            AdminChannel?
  recipientId        String?
  supervisorActionId String?
  createdAt          DateTime          @default(now())

  supervisorAction SupervisorAction? @relation(fields: [supervisorActionId], references: [id])

  @@index([level, createdAt])
  @@index([boardId, createdAt])
  @@map("admin_notifications")
}

enum NotificationLevel {
  INFO
  WARNING
  ERROR
  CRITICAL
}

// ============================================
// WEBHOOK IDEMPOTENCY
// ============================================

model ProcessedWebhook {
  id          String   @id @default(cuid())
  externalId  String
  channel     String
  boardId     String
  processedAt DateTime @default(now())

  @@unique([externalId, channel, boardId])
  @@index([processedAt])
  @@map("processed_webhooks")
}

// ============================================
// SUPERVISOR AGENT
// ============================================

model SupervisorAction {
  id             String               @id @default(cuid())

  // Context
  boardId        String
  leadId         String?
  conversationId String?

  // Trigger
  triggerType    SupervisorTriggerType
  triggerContext Json                 @default("{}")

  // Decision
  proposedAction SupervisorActionType
  actionParams   Json                 @default("{}")
  reasoning      String               @db.Text
  urgency        SupervisorUrgency    @default(NORMAL)

  // Approval
  status                ApprovalStatus @default(PENDING_ADMIN)
  notificationSentAt    DateTime?
  notificationChannel   AdminChannel?
  notificationMessageId String?
  approverUserId        String?
  approvedAt            DateTime?
  rejectedAt            DateTime?
  rejectReason          String?

  // Execution
  executedAt      DateTime?
  executionResult Json?
  executionError  String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board        Board             @relation(fields: [boardId], references: [id], onDelete: Cascade)
  lead         Lead?             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  conversation Conversation?     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  approver     User?             @relation("ActionApprover", fields: [approverUserId], references: [id])
  notifications AdminNotification[]

  @@index([status, createdAt])
  @@index([boardId, createdAt])
  @@map("supervisor_actions")
}

enum SupervisorTriggerType {
  AGENT_STUCK
  HANDOFF_REPEATEDLY_BLOCKED
  TOOL_FAILURE_PATTERN
  NO_LEAD_REPLY_TIMEOUT
  ESCALATION_REQUESTED
  PERIODIC_AUDIT_FINDING
  ON_DEMAND_QUERY
}

enum SupervisorActionType {
  RESET_STATE
  REASSIGN_TO_STATE
  PAUSE_LEAD
  RESUME_LEAD
  FORCE_HANDOFF
  NOTIFY_ONLY
  KILL_CONVERSATION
  UPDATE_LEAD_SCORE
  REQUEST_HUMAN_TAKEOVER
}

enum SupervisorUrgency {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum ApprovalStatus {
  PENDING_ADMIN
  APPROVED
  REJECTED
  AUTO_APPROVED
  EXECUTED
  FAILED
  EXPIRED
}
